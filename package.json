{
  "name": "dot-motion-builder",
  "description": "A local-first visual editor for designing dot-matrix loading animations and exporting production-ready Web and SwiftUI code.",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:motion": "node scripts/test-motion.cjs",
    "test:exports": "node scripts/test-exports.cjs",
    "test": "pnpm run typecheck && pnpm run test:motion && pnpm run test:exports && pnpm run test:idotmatrix && pnpm run test:agent",
    "test:idotmatrix": "node scripts/test-idotmatrix.cjs && node scripts/test-idotmatrix-live.cjs",
    "start:fast": "next build && next start --port 4321",
    "test:agent": "node scripts/test-agent-display.cjs && node scripts/test-desktop.cjs && node scripts/test-mcp.cjs && node scripts/test-editor-tools.cjs",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:start": "node scripts/build-desktop.mjs && electron .",
    "desktop:dist": "node scripts/build-desktop.mjs && electron-builder --win"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.2.8",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "next": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@next/swc-wasm-nodejs": "^15.5.15",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.0.0"
  },
  "main": "desktop/dist/main.cjs",
  "build": {
    "appId": "io.github.zhehaosun717.dotmatrixstudio",
    "productName": "Dot Matrix Studio",
    "directories": {
      "output": "release",
      "buildResources": "desktop/build"
    },
    "files": [
      "desktop/dist/**/*",
      "package.json",
      "!**/node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "web"
      },
      {
        "from": "mcp/dist",
        "to": "mcp"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Dot Matrix Studio"
    },
    "npmRebuild": false,
    "electronDist": "node_modules/electron/dist"
  }
}
